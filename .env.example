# Copy to .env and replace this local-only placeholder before starting.
POSTGRES_USER=cinematch
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=cinematch
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379/0
BACKEND_PORT=8000
FRONTEND_PORT=5173
APP_ENV=development
# JSON array. Same-origin proxy is preferred.
CORS_ORIGINS=["http://localhost:5173"]
# Server-only Vite proxy target; no secrets belong in VITE_* variables.
API_PROXY_TARGET=http://localhost:8000
